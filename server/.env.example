# AviQuest Inference Server — Environment Variables
# Copy to .env and modify as needed.

MODEL_MODE=stub            # "stub" for fake predictions, "real" for ML model
MODEL_VERSION=aviquest-v1.0.0-stub
API_KEY=                   # Leave empty to disable auth; set to require X-API-Key header
MAX_IMAGE_BYTES=10485760   # 10 MB
MAX_AUDIO_BYTES=26214400   # 25 MB
REQUEST_TIMEOUT_S=30
HOST=0.0.0.0
PORT=8000
