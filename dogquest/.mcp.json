{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@claude-flow/cli@3.5.80",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_POOL_ENABLED": "true",
        "CLAUDE_FLOW_POOL_MAX": "15",
        "CLAUDE_FLOW_CACHE_ENABLED": "true",
        "CLAUDE_FLOW_TRANSPORT": "stdio",
        "CLAUDE_FLOW_COMPRESSION": "true",
        "CLAUDE_FLOW_FLASH_ATTENTION": "true",
        "CLAUDE_FLOW_ATTENTION_BLOCK_SIZE": "64",
        "CLAUDE_FLOW_AGENTDB_ENABLED": "true",
        "CLAUDE_FLOW_AGENTDB_WASM": "true",
        "CLAUDE_FLOW_AGENTDB_HNSW_EF": "100"
      },
      "autoStart": false
    }
  }
}