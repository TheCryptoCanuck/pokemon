{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Assignment",
  "description": "Schema for individual agent task assignments from Master Orchestrator v3",
  "type": "object",
  "required": ["agent", "priority", "task", "context"],
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "strategy-lead",
        "product-execution",
        "architecture-lead",
        "build-engineer",
        "reliability-lead",
        "growth-revenue-lead"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Execution priority assigned by orchestrator"
    },
    "task": {
      "type": "object",
      "required": ["description", "kpi_target", "acceptance_criteria"],
      "properties": {
        "description": {
          "type": "string",
          "description": "Clear description of what needs to be done"
        },
        "kpi_target": {
          "type": "string",
          "description": "Which KPI this task targets — required for every task"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Measurable conditions for task completion"
        },
        "deadline": {
          "type": "string",
          "description": "When this task must be completed"
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Other agent tasks this depends on"
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "company_state": {
          "type": "string",
          "enum": [
            "DISCOVERY", "MVP_BUILD", "HARDENING", "LAUNCH",
            "GROWTH_OPTIMIZATION", "SCALE", "INCIDENT",
            "RUNWAY_CRITICAL", "PIVOT"
          ]
        },
        "capital_position": {
          "type": "string",
          "enum": ["learning", "retention", "revenue", "survival"]
        },
        "primary_constraint": {
          "type": "string"
        },
        "relevant_kpis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "value": { "type": ["number", "string"] },
              "status": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "scope_limit": {
          "type": "string",
          "description": "Maximum scope boundary"
        },
        "blocked_actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions explicitly forbidden in current state"
        },
        "required_gates": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Approvals needed before completion"
        }
      }
    }
  }
}
